{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1180px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": false,
      "palette": [
        {
          "slug": "navy",
          "color": "#111D32",
          "name": "Navy"
        },
        {
          "slug": "navy-deep",
          "color": "#0A1422",
          "name": "Navy Deep"
        },
        {
          "slug": "steel",
          "color": "#3E5875",
          "name": "Steel Blue"
        },
        {
          "slug": "accent",
          "color": "#2F6FED",
          "name": "CTA Accent"
        },
        {
          "slug": "charcoal",
          "color": "#1B2430",
          "name": "Charcoal"
        },
        {
          "slug": "slate",
          "color": "#4F5D70",
          "name": "Slate"
        },
        {
          "slug": "border",
          "color": "#DCDAD0",
          "name": "Border"
        },
        {
          "slug": "off-white",
          "color": "#F4F3EC",
          "name": "Warm Off White"
        },
        {
          "slug": "white",
          "color": "#FFFFFF",
          "name": "White"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontSizes": [
        {
          "slug": "x-small",
          "name": "X Small",
          "size": "0.8125rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "1.0625rem",
          "fluid": {
            "min": "1.0625rem",
            "max": "1.125rem"
          }
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "1.25rem",
          "fluid": {
            "min": "1.125rem",
            "max": "1.3125rem"
          }
        },
        {
          "slug": "x-large",
          "name": "X Large",
          "size": "1.75rem",
          "fluid": {
            "min": "1.4rem",
            "max": "1.875rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "2X Large",
          "size": "2.5rem",
          "fluid": {
            "min": "1.9rem",
            "max": "2.75rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "4rem",
          "fluid": {
            "min": "2.5rem",
            "max": "4.25rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ],
      "spacingScale": {
        "steps": 0
      },
      "spacingSizes": [
        {
          "slug": "20",
          "name": "1",
          "size": "0.5rem"
        },
        {
          "slug": "30",
          "name": "2",
          "size": "1rem"
        },
        {
          "slug": "40",
          "name": "3",
          "size": "1.5rem"
        },
        {
          "slug": "50",
          "name": "4",
          "size": "2.5rem"
        },
        {
          "slug": "60",
          "name": "5",
          "size": "4rem"
        },
        {
          "slug": "70",
          "name": "6",
          "size": "6rem"
        },
        {
          "slug": "80",
          "name": "7",
          "size": "clamp(5rem, 10vw, 9rem)"
        }
      ]
    },
    "border": {
      "radius": true,
      "color": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "soft",
          "name": "Soft",
          "shadow": "0 1px 2px rgba(17,29,50,.06), 0 8px 24px -14px rgba(17,29,50,.20)"
        },
        {
          "slug": "lifted",
          "name": "Lifted",
          "shadow": "0 1px 3px rgba(17,29,50,.08), 0 18px 40px -18px rgba(17,29,50,.28)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--charcoal)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--manrope)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65",
      "letterSpacing": "-0.005em"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "var(--wp--preset--spacing--40)",
        "right": "var(--wp--preset--spacing--40)"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--manrope)",
          "fontWeight": "700",
          "lineHeight": "1.15",
          "letterSpacing": "-0.022em"
        },
        "color": {
          "text": "var(--wp--preset--color--navy)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--display)",
          "lineHeight": "1.04",
          "letterSpacing": "-0.032em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "lineHeight": "1.12",
          "letterSpacing": "-0.026em"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "lineHeight": "1.25"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "lineHeight": "1.35"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--accent)"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--navy)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "var(--wp--preset--color--white)"
        },
        "typography": {
          "fontWeight": "600",
          "fontSize": "var(--wp--preset--font-size--medium)",
          "letterSpacing": "-0.01em"
        },
        "border": {
          "radius": "8px"
        },
        "spacing": {
          "padding": {
            "top": "0.9rem",
            "bottom": "0.9rem",
            "left": "1.6rem",
            "right": "1.6rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--navy)",
            "text": "var(--wp--preset--color--white)"
          }
        },
        ":focus": {
          "color": {
            "background": "var(--wp--preset--color--navy)",
            "text": "var(--wp--preset--color--white)"
          }
        }
      }
    },
    "blocks": {
      "core/code": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fira-code)",
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "core/quote": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)"
        },
        "color": {
          "text": "var(--wp--preset--color--navy)"
        }
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--border)"
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "page-audit",
      "title": "Audit landing (no navigation)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
